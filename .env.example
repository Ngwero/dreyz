# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prefer Session pooler (IPv4) for local/dev machines
DATABASE_URL=postgresql://postgres.PROJECT:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Public site URL (emails + RukaPay webhook defaults)
NEXT_PUBLIC_APP_URL=https://www.dreyzschool.com

# Demo seed logins (dreyz2026). Off in production unless set to true.
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false

# Email (required for OTP, welcome, notices)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Dreyz Interior <noreply@dreyzschool.com>"

# RukaPay (server-only — never put the key in NEXT_PUBLIC_*)
RUKAPAY_API_KEY=your_rukapay_x_api_key
RUKAPAY_ENVIRONMENT=development
